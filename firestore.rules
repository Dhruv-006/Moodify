rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to verify ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      // User profile document: contains name, gender, dob, lastMood, lastMoodTimestamp
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        // Ensure they aren't inserting fields like 'admin'
        && request.resource.data.keys().hasOnly(['name', 'gender', 'dob', 'lastMood', 'lastMoodTimestamp']);
      allow delete: if isOwner(userId);

      // User's private moods (which also act as journals/history)
      match /moods/{moodId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          // Based on MoodEntry schema: moodType, date, note, activities
          && request.resource.data.keys().hasOnly(['moodType', 'date', 'note', 'activities']);
        allow delete: if isOwner(userId);
      }
    }
  }
}
